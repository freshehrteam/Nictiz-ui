{
  "name": "freshehr-nictiz-ui-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:vite": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "seed": "tsx scripts/seed.ts",
    "register": "tsx scripts/register-clients.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "stack:verify": "bash scripts/stack-verify.sh"
  },
  "dependencies": {
    "medblocks-ui": "0.0.217",
    "lit": "^3.2.1",
    "@shoelace-style/shoelace": "2.0.0-beta.71"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "happy-dom": "^15.11.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "express": "^4.21.0",
    "@types/express": "^4.17.21",
    "dotenv": "^16.4.5",
    "@playwright/test": "^1.49.0"
  },
  "overrides": {
    "@shoelace-style/shoelace": "2.0.0-beta.71"
  }
}
