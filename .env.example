# Copy to .env at the repository root. The BFF reads this; the browser never does.
#
# NOTE: EHRBASE_AUTH_* is a single SHARED credential. The BFF applies no
# per-user access control, so anyone who can reach it can read and write every
# record. See the Security section of the README before deploying anything.

EHRBASE_BASE=http://localhost:8082/ehrbase/rest/openehr/v1
EHRBASE_AUTH_USER=ehrbase-user
EHRBASE_AUTH_PASSWORD=SuperSecretPassword

FHIR_BASE=http://localhost:8080/fhir

# openFHIR (FHIR Connect mapping engine). Server-side only: it has no auth and
# no CORS, so the browser never reaches it — every call goes through the BFF.
OPENFHIR_BASE=http://localhost:8083

# BFF port, and the origin the Vite dev server is served from.
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Deployment-only settings ─────────────────────────────────────────────────
# All of these are set by the Helm chart in a real deployment. They are listed
# here so the full surface is visible in one place; leave them unset locally.
#
# REQUIRE_AUTH   Reject any request that did not arrive through an
#                authenticating proxy. Set "true" in every deployed environment
#                — it is what makes a misconfigured ingress fail closed rather
#                than silently publish the whole CDR. Unset locally, where Vite
#                talks to the BFF directly and there is no proxy.
#
# TRUST_BASIC_AUTH
#                Read the caller's username from the Authorization header that
#                ingress-nginx's basic-auth forwards. Only meaningful when
#                basic-auth is the gate.
#
# DEFAULT_USER_NAME
#                What lands in `composer|name`. With a shared basic-auth login
#                this is a deployment identity, not a person — deliberately not
#                a plausible clinician name.
#
# STATIC_DIR     Serve the built SPA from this same process (the container sets
#                /app/dist). Unset locally: Vite serves the SPA and proxies /api.
#
# REQUIRE_AUTH=true
# TRUST_BASIC_AUTH=true
# DEFAULT_USER_NAME=Demo User
# STATIC_DIR=/app/dist

# Used by scripts/seed.ts only.
TEMPLATE_ID=EPS Patient Summary
